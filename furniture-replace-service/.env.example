# Copy to .env and adjust. All optional — sensible defaults live in app/config.py.

# "cuda" or "cpu". CPU works but is dramatically slower (minutes per replace).
DEVICE=cuda

# If set, every /v1/* request must send header  X-Service-Key: <this value>
# SERVICE_API_KEY=change-me

# Leave blank for standalone mode; root Compose sets the private backend gateway.
GPU_QUEUE_URL=
GPU_QUEUE_ACQUIRE_TIMEOUT_SECONDS=900
GPU_QUEUE_HEARTBEAT_SECONDS=5

# Vector DB. Inside docker-compose use http://qdrant:6333; locally http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=catalog_products

# Where weights / results / catalog images live (one dir => one docker volume).
DATA_DIR=./data

# Offload an idle heavy model from GPU after this many seconds.
MODEL_IDLE_OFFLOAD_SECONDS=180

SERVICE_PORT=8000
QDRANT_PORT=6333
# SAM2_MODEL=facebook/sam2.1-hiera-tiny
# IP_ADAPTER_WEIGHT=ip-adapter-plus_sd15.bin
PROMPT_CLEAN_FIRST=false
INPAINT_CROP_PADDING=0
# PROMPT_INPAINT_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1

# Local BrushNet checkpoint dir (optional). Absent -> prompt mode uses SD1.5 inpainting.
# BRUSHNET_MODEL=data/weights/brushnet_random_mask
